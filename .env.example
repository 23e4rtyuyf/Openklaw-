# ── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=openai              # openai | anthropic | openai_compatible
AI_MODEL=gpt-4o-mini
AI_BASE_URL=                    # for Ollama, OpenRouter, etc.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...        # your Twilio phone number

# ── Slack (for inbound Slack Events) ─────────────────────────────────────────
SLACK_SIGNING_SECRET=           # from Slack app settings

# ── Server ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./openklaw.db
PORT=8080
